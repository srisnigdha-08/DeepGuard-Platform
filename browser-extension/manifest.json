{
  "manifest_version": 3,
  "name":        "DeepGuard — DeepFake Detector",
  "version":     "1.0.0",
  "description": "Right-click any image or video to detect deepfake manipulation.",

  "permissions": ["activeTab", "contextMenus", "storage", "scripting"],

  "host_permissions": [
    "http://localhost:5000/*",
    "https://*.onrender.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon":  { "48": "icons/icon48.png" },
    "default_title": "DeepGuard"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
