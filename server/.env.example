NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/deepfake_db
# Dedicated isolated test database URI (local loopback only, must contain 'test')
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/deepguard_test
JWT_ACCESS_SECRET=generate_with_node_-e_console.log(require('crypto').randomBytes(64).toString('hex'))
JWT_REFRESH_SECRET=different_64_char_random_hex_string
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=generate_with_node_-e_console.log(require('crypto').randomBytes(32).toString('hex'))
LOG_LEVEL=info
