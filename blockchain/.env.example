# DeepGuard Blockchain Prototype Environment Variables
# Copy to .env for local/testnet deployment.
# NEVER commit your real private key or Alchemy API key to source control!

# Alchemy or Infura RPC API Key
ALCHEMY_KEY=your_alchemy_api_key_here

# Deployer wallet private key (hex, without 0x prefix) — TESTNET ONLY
BLOCKCHAIN_PRIVATE_KEY=your_testnet_private_key_here

# Enable gas reporter during tests (optional)
REPORT_GAS=false
